# fleet-supervisor.conf — copy to .claude/fleet-supervisor.conf and edit.
# Read by the agent-sessions skill's fleet-supervisor.sh (launchd, ~5 min).
# Only ledger-bearing monster sessions belong here — as many as you run;
# interactive roles have no heartbeat contract and are never auto-relaunched.
TMUX_SESSION=acme
LAUNCH_CMD=bash .claude/skills/agent-sessions/scripts/launch-agent-sessions.sh --roster .claude/agent-sessions.roster
# Repo holding the ledgers. Omit to use `gh repo view` in the cwd (supervisor
# running inside the target repo); REQUIRED when it runs from a fleet repo.
REPO=owner/name
# <session>|<ledger issue>|<stale minutes>[|<owner/name>]
#   stale = heartbeat older than this; mirror the monster's stale_lock_minutes
#   + grace. The optional 4th field overrides REPO= (multi-repo fleets).
acme-mm|0|60
acme-maintain|0|60
# acme-<role>|0|60
# other-mm|0|60|owner/other-repo
