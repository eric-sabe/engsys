#!/usr/bin/env bash
# post-compact-reground.sh — SessionStart hook, matcher "compact".
# Fires immediately AFTER context compaction; stdout is injected into the
# fresh context. (PreCompact stdout is NOT injected into the summarization —
# this post-compaction channel is the one that reaches the model.)
# Must be fast and fail-open: static text only, no network calls, no state reads. The one
# exception is the operator time line below: it formats the current time from OPERATOR_* env, no I/O.
# Rendered by the engsys installer; static content, no project fills.
# The plugin root: under Claude Code only its own CLAUDE_PLUGIN_ROOT counts (the same rule as
# core/lib/harness-io.mjs resolvePluginRoot), so an ENGSYS_PLUGIN_ROOT from a settings env or the
# caller can never point this hook at another tree's code. The others are for the other harnesses.
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then PLUGIN_ROOT="$CLAUDE_PLUGIN_ROOT"
elif [ -n "${COPILOT_PLUGIN_ROOT:-}" ]; then PLUGIN_ROOT="$COPILOT_PLUGIN_ROOT"
elif [ -n "${AGY_PLUGIN_ROOT:-}" ]; then PLUGIN_ROOT="$AGY_PLUGIN_ROOT"
else PLUGIN_ROOT="${ENGSYS_PLUGIN_ROOT:-}"; fi
TIME_LINE=""
if [ -n "${OPERATOR_TIMEZONE:-}${OPERATOR_CLOCK:-}" ] && [ -n "$PLUGIN_ROOT" ] && [ -f "$PLUGIN_ROOT/lib/operator-time.mjs" ] && command -v node >/dev/null 2>&1; then
  TIME_LINE="$(node "$PLUGIN_ROOT/lib/operator-time.mjs" context-line 2>/dev/null || true)"
fi
# A quoted heredoc read straight into BODY, not BODY="$(cat <<'EOF' ...)": bash 3.2 (stock macOS /bin/bash)
# scans a heredoc inside $( ) for quotes, so an unpaired apostrophe in the text ("agent's") fails the whole hook.
# read -d '' returns 1 at the heredoc's end, hence || true; it keeps the text's final newline, which $( ) dropped.
IFS= read -r -d '' BODY <<'EOF' || true
Context was just compacted. Durable state, not the summary, is the source of truth:
1. If this session runs a long-lived skill (merge-monster, maintenance-monster, or similar): re-read its SKILL.md AND every references/*.md file that SKILL.md names (merge-monster: references/runbook-details.md; maintenance-monster: references/phase-details.md), its config (.claude/*.yml, or the fleet-config-dir copy whose path heads state.md), and <state_dir>/state.md, then reconcile against live GitHub per the skill's Session startup steps — the summary is not your operating contract; the files are.
2. Treat summarized precision as unverified: PR/issue numbers, SHAs, attempt counters, deadlines. Re-check from files or GitHub before acting on any of them.
3. If you were mid-task: your working tree (git status), the task list, and your own state files are the resume point — not the summary's narrative.
EOF
BODY="${BODY%$'\n'}"
if [ -n "$TIME_LINE" ]; then
  BODY="$BODY
$TIME_LINE"
fi
if command -v node >/dev/null 2>&1; then
  node -e 'const c=process.argv[1]+"\n";process.stdout.write(JSON.stringify({additionalContext:c,hookSpecificOutput:{hookEventName:"SessionStart",additionalContext:c}})+"\n")' "$BODY"
else
  printf '%s\n' "$BODY"
fi
