# {{ORG}} fleet session env: TEMPLATE rendered by `fleet launch` into .fleet/env/session.env and
# sourced (POSIX sh: the pane's login shell may be zsh) into every fleet session that does not name
# its own env in the roster. When GH_APP_ENV is set, `fleet launch` appends the fleet's GitHub identity:
# the env-scoped git credential + bot author, the gh shim first on PATH, and GH_APP_ENV_FILE.
{{#if azure}}
# Azure: the service principal's EnvironmentCredential vars and the isolated az profile.
[ -f "__AZURE_SP_ENV__" ] && . "__AZURE_SP_ENV__"
{{/if}}
# Never inherit a token from the launching shell (for example a direnv-managed login): tools that read
# GH_TOKEN directly would otherwise act as that person instead of the fleet identity.
unset GH_TOKEN GITHUB_TOKEN
# Model alias pins (fleet/fleet.conf): persona `model: opus|sonnet|fable|haiku` resolves through these.
ANTHROPIC_DEFAULT_OPUS_MODEL="__OPUS_MODEL__"
ANTHROPIC_DEFAULT_SONNET_MODEL="__SONNET_MODEL__"
ANTHROPIC_DEFAULT_FABLE_MODEL="__FABLE_MODEL__"
ANTHROPIC_DEFAULT_HAIKU_MODEL="__HAIKU_MODEL__"
