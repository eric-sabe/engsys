# {{ORG}} fleet session env, security lane: TEMPLATE rendered into .fleet/env/security.env.
# Everything from the general session env, then the opus and fable aliases pointed at SECURITY_MODEL.
# Named in the roster's 5th field for the maintenance monster.
. "__ENV_DIR__/session.env"
ANTHROPIC_DEFAULT_OPUS_MODEL="__SECURITY_MODEL__"
ANTHROPIC_DEFAULT_FABLE_MODEL="__SECURITY_MODEL__"
# A subagent model override (CLAUDE_CODE_SUBAGENT_MODEL[_FORCE]) would move pinned security agents off
# their model: never inherited into the security lane.
unset CLAUDE_CODE_SUBAGENT_MODEL CLAUDE_CODE_SUBAGENT_MODEL_FORCE
