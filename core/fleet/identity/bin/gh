#!/usr/bin/env bash
# gh (fleet shim) — run the real GitHub CLI as the fleet's GitHub App bot.
#
# Put this directory FIRST on PATH for fleet sessions (the launcher does). Every
# invocation fetches a current App installation token from gh-app-token.mjs
# (cached; re-minted only near its 1-hour expiry), exports it as GH_TOKEN, and
# execs the real gh. Long-lived sessions therefore never hold a stale token.
# GH_APP_ENV_FILE must point at the App env file (the fleet environment sets it).
#
# Break-glass: call the real gh by absolute path (e.g. /opt/homebrew/bin/gh) to
# act as whoever that gh is logged in as. Note that installation tokens have no
# "user": `gh api /user`, `@me`, and `gh auth status` don't describe the bot.
set -euo pipefail

SHIM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# First `gh` on PATH that is not this shim.
REAL_GH=""
IFS=: read -r -a _dirs <<<"${PATH}"
for d in "${_dirs[@]}"; do
  [ -n "$d" ] || continue
  if [ -x "$d/gh" ] && [ "$(cd "$d" 2>/dev/null && pwd -P)" != "$SHIM_DIR" ]; then
    REAL_GH="$d/gh"
    break
  fi
done
[ -n "$REAL_GH" ] || { echo "gh (fleet shim): real gh not found on PATH" >&2; exit 127; }

# Which account's installation to use (GH_APP_INSTALLATIONS in the env file). Precedence:
# GH_APP_OWNER > --owner (names the account a command like `gh project`/`gh repo list`/
# `gh search --owner` acts on) > -R/--repo > a `gh api repos/<owner>/...` path > a github.com
# URL argument > the current repo's origin. The token helper falls back to
# GH_APP_INSTALLATION_ID for an owner it doesn't list.
owner_of() { # owner/repo, URL or api path -> owner, or nothing
  local s="${1#https://github.com/}"
  s="${s#/}"; s="${s#repos/}"
  case "$s" in */*) printf '%s' "${s%%/*}" ;; esac
}
OWNER_OPT="" REPO_OPT="" API_OWNER="" URL_OWNER=""
prev=""
for a in "$@"; do
  case "$prev" in
    --owner) [ -n "$OWNER_OPT" ] || OWNER_OPT="$a" ;;
    -R|--repo) [ -n "$REPO_OPT" ] || REPO_OPT="$(owner_of "$a")" ;;
  esac
  case "$a" in
    --owner=*) [ -n "$OWNER_OPT" ] || OWNER_OPT="${a#--owner=}" ;;
    --repo=*) [ -n "$REPO_OPT" ] || REPO_OPT="$(owner_of "${a#--repo=}")" ;;
    -R?*) [ -n "$REPO_OPT" ] || REPO_OPT="$(owner_of "${a#-R}")" ;;
    repos/*/*|/repos/*/*) [ -n "$API_OWNER" ] || API_OWNER="$(owner_of "$a")" ;;
    https://github.com/*/*) [ -n "$URL_OWNER" ] || URL_OWNER="$(owner_of "$a")" ;;
  esac
  prev="$a"
done
OWNER="${GH_APP_OWNER:-}"
[ -n "$OWNER" ] || OWNER="$OWNER_OPT"
[ -n "$OWNER" ] || OWNER="$REPO_OPT"
[ -n "$OWNER" ] || OWNER="$API_OWNER"
[ -n "$OWNER" ] || OWNER="$URL_OWNER"
if [ -z "$OWNER" ] && url="$(git remote get-url origin 2>/dev/null)"; then
  case "$url" in
    https://github.com/*) OWNER="$(owner_of "$url")" ;;
    git@github.com:*) OWNER="$(owner_of "${url#git@github.com:}")" ;;
  esac
fi

if ! TOKEN="$(GH_APP_OWNER="$OWNER" node "$SHIM_DIR/../gh-app-token.mjs")"; then
  echo "gh (fleet shim): could not obtain a GitHub App token — run gh-app-login.sh (next to gh-app-token.mjs) for a diagnosis" >&2
  exit 1
fi

GH_TOKEN="$TOKEN" exec "$REAL_GH" "$@"
