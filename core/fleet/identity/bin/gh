#!/usr/bin/env bash
# gh (fleet shim) — run the real GitHub CLI as the fleet's GitHub App bot.
#
# Put this directory FIRST on PATH for fleet sessions (the launcher does). Every
# invocation fetches a current App installation token from gh-app-token.mjs
# (cached; re-minted only near its 1-hour expiry), exports it as GH_TOKEN, and
# execs the real gh. Long-lived sessions therefore never hold a stale token.
# GH_APP_ENV_FILE must point at the App env file (the fleet environment sets it).
#
# Break-glass: call the real gh by absolute path (e.g. /opt/homebrew/bin/gh) to
# act as whoever that gh is logged in as. Note that installation tokens have no
# "user": `gh api /user`, `@me`, and `gh auth status` don't describe the bot.
# engsys-fleet-gh-shim: identity marker. Every copy of this shim carries it, and the search below skips any
# candidate that does (see "First gh on PATH"). Keep it in the first 4 KB of the file.
set -euo pipefail

SHIM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# First `gh` on PATH that is not a copy of this shim. A candidate is a shim copy when it is this
# script's own directory OR its first 4 KB carries the identity marker, so two checkouts' copies on PATH
# never resolve each other as "the real gh" and exec in a loop (engsys#190).
# The other patterns are the header and the error-message prefix of shims from before the marker existed, so a
# mixed-version pair on PATH resolves too, in either order.
is_shim_copy() { head -c 4096 "$1" 2>/dev/null | grep -aqE 'engsys-fleet-gh-shim:|^# gh \(fleet shim\) |gh \(fleet shim\):'; }
REAL_GH=""
IFS=: read -r -a _dirs <<<"${PATH}"
for d in "${_dirs[@]}"; do
  [ -n "$d" ] || continue
  if [ -x "$d/gh" ] && [ "$(cd "$d" 2>/dev/null && pwd -P)" != "$SHIM_DIR" ] && ! is_shim_copy "$d/gh"; then
    REAL_GH="$d/gh"
    break
  fi
done
# Backstop for anything the marker misses (a hand-edited copy, a wrapper around the shim): a bounded hop
# count instead of an unbounded exec chain.
SHIM_HOPS="${ENGSYS_GH_SHIM_HOPS:-0}"
case "$SHIM_HOPS" in '' | *[!0-9]*) SHIM_HOPS=0 ;; esac
if [ "$SHIM_HOPS" -ge 8 ]; then echo "gh (fleet shim): exec loop detected ($SHIM_HOPS hops) — two gh wrappers on PATH resolve each other. gh on PATH: $(IFS=:; for d in $PATH; do [ -x "$d/gh" ] && printf '%s ' "$d/gh"; done). Remove all but the real gh and one fleet shim." >&2; exit 126; fi
export ENGSYS_GH_SHIM_HOPS=$((SHIM_HOPS + 1))
[ -n "$REAL_GH" ] || { echo "gh (fleet shim): real gh not found on PATH" >&2; exit 127; }

# engsys v2.0.1 round 2 (F5, Nyx F3): the Copilot-CLI seat-token relay that used to live here is
# REMOVED entirely. The fleet is Claude-only (CLAUDE.md: "the fleet is Claude-only unless the
# operator explicitly opts in through a GitHub gate") — the relay was dead code for the fleet's
# actual operating mode, and it was still a bypassable identity boundary (round 1 tightened the
# PID check instead of removing the relay; round 2's review called that the wrong fix). This shim
# now NEVER returns anything but the fleet's own App installation token, for every invocation,
# including `gh auth token`/`gh auth status`. GH_TOKEN_COPILOT_CLI is never read.
unset GH_TOKEN_COPILOT_CLI

# Which account's installation to use (GH_APP_INSTALLATIONS in the env file). Precedence:
# GH_APP_OWNER > --owner (names the account a command like `gh project`/`gh repo list`/
# `gh search --owner` acts on) > -R/--repo > the owner a `gh api` endpoint names (`repos/<owner>/…`,
# `orgs/<org>/…`, `users/<user>/…`) > an owner a `-f/-F` field names > a github.com URL argument > the current
# repo's origin. The token helper falls back to GH_APP_INSTALLATION_ID (the fleet instance's own installation; a process-env
# GH_APP_INSTALLATION_ID overrides the env file's) for an owner it doesn't list.
# engsys#257: `gh api` endpoints that can't be about any repo (`/apps/<slug>`, `/app`, `/user`, `installation/*`,
# `rate_limit`) take the instance installation, never the cwd's origin. GraphQL and `search/*` may well be about
# the cwd's repo (mutations, private-repo search), so they keep the origin fallback, unless the call names an owner
# in a field (`-f owner=X`, `-F owner=X`, or `repo=<owner>/<name>`), which then picks it. `repos/{owner}/{repo}/…`
# placeholders are gh's own "the cwd's repo", so they too fall back to origin.
owner_of() { # owner/repo, URL or api path -> owner, or nothing
  local s="${1#https://github.com/}"
  s="${s#/}"; s="${s#repos/}"
  case "$s" in */*) printf '%s' "${s%%/*}" ;; esac
}
# api_endpoint_owner <endpoint> -> "owner:<login>" | "ownerless" | "" (not classified: the origin fallback applies)
api_endpoint_owner() {
  local e="${1#/}" rest
  e="${e%%\?*}"
  case "$e" in
    repos/\{owner\}/*) ;; # gh's placeholder for the cwd's repo
    repos/*/*) printf 'owner:%s' "$(owner_of "$e")" ;;
    orgs/*|users/*)
      rest="${e#*/}"; rest="${rest%%/*}"
      [ -n "$rest" ] && printf 'owner:%s' "$rest" ;;
    user|user/*|app|app/*|apps/*|installation/*|rate_limit)
      printf 'ownerless' ;;
  esac
}
# field_owner <field value> -> the owner a `-f/-F` field names (`owner=X`, or `repo=X/Y`), or nothing
field_owner() {
  case "$1" in
    owner=*) printf '%s' "${1#owner=}" ;;
    repo=*/*) printf '%s' "$(owner_of "${1#repo=}")" ;;
  esac
}
OWNER_OPT="" REPO_OPT="" API_OWNER="" URL_OWNER="" API_OWNERLESS="" FIELD_OWNER=""
# The `gh api` endpoint is the first positional argument after `api` that is not a flag's value.
API_EP="" in_api="" skip_next=""
prev=""
for a in "$@"; do
  case "$prev" in
    --owner) [ -n "$OWNER_OPT" ] || OWNER_OPT="$a" ;;
    -R|--repo) [ -n "$REPO_OPT" ] || REPO_OPT="$(owner_of "$a")" ;;
    -f|-F|--raw-field|--field) [ -z "$in_api" ] || [ -n "$FIELD_OWNER" ] || FIELD_OWNER="$(field_owner "$a")" ;;
  esac
  case "$a" in
    --raw-field=*|--field=*) [ -z "$in_api" ] || [ -n "$FIELD_OWNER" ] || FIELD_OWNER="$(field_owner "${a#*=}")" ;;
  esac
  case "$a" in
    --owner=*) [ -n "$OWNER_OPT" ] || OWNER_OPT="${a#--owner=}" ;;
    --repo=*) [ -n "$REPO_OPT" ] || REPO_OPT="$(owner_of "${a#--repo=}")" ;;
    -R?*) [ -n "$REPO_OPT" ] || REPO_OPT="$(owner_of "${a#-R}")" ;;
    https://github.com/*/*) [ -n "$URL_OWNER" ] || URL_OWNER="$(owner_of "$a")" ;;
  esac
  if [ -z "$in_api" ]; then
    [ "$a" = api ] && [ -z "$prev" ] && in_api=1
  elif [ -z "$API_EP" ]; then
    if [ -n "$skip_next" ]; then skip_next=""
    else
      case "$a" in
        -X|--method|-H|--header|-f|--raw-field|-F|--field|--input|-q|--jq|-t|--template|--hostname|--cache|-p|--preview) skip_next=1 ;;
        -*) ;;
        *) API_EP="$a" ;;
      esac
    fi
  fi
  prev="$a"
done
if [ -n "$API_EP" ]; then
  case "$(api_endpoint_owner "$API_EP")" in
    owner:*) cls="$(api_endpoint_owner "$API_EP")"; API_OWNER="${cls#owner:}" ;;
    ownerless) API_OWNERLESS=1 ;;
  esac
fi
OWNER="${GH_APP_OWNER:-}"
[ -n "$OWNER" ] || OWNER="$OWNER_OPT"
[ -n "$OWNER" ] || OWNER="$REPO_OPT"
[ -n "$OWNER" ] || OWNER="$API_OWNER"
[ -n "$OWNER" ] || OWNER="$FIELD_OWNER"
[ -n "$OWNER" ] || OWNER="$URL_OWNER"
if [ -z "$OWNER" ] && [ -z "$API_OWNERLESS" ] && url="$(git remote get-url origin 2>/dev/null)"; then
  case "$url" in
    https://github.com/*) OWNER="$(owner_of "$url")" ;;
    git@github.com:*) OWNER="$(owner_of "${url#git@github.com:}")" ;;
  esac
fi

if ! TOKEN="$(GH_APP_OWNER="$OWNER" node "$SHIM_DIR/../gh-app-token.mjs")"; then
  echo "gh (fleet shim): could not obtain a GitHub App token — run gh-app-login.sh (next to gh-app-token.mjs) for a diagnosis" >&2
  exit 1
fi

GH_TOKEN="$TOKEN" exec "$REAL_GH" "$@"
