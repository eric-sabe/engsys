#!/usr/bin/env bash
# fleet — one entry point for operating an engsys fleet from its host.
#
#   fleet [--instance <dir>] <command> [args]
#
#   status                        fleet id + registry homes, pins vs host, and which sessions are behind
#   status --federation [--json]  every fleet (heartbeat ages) and every baton (holder, expiry,
#                                 holder != home flag), read-only
#   pin ...                       release the instance + open the pin PR (see `fleet pin --help`)
#   sync [--check]                host checkouts + plugin reinstall to match the pins (no restarts)
#   restart [--stale|--all|<name>...] [--force]
#                                 cycle sessions when you're ready (no args = status)
#   launch [<name> [--force-excluded] [--skip-verify]] | --check <name>
#                                 start missing sessions that run on this host (all, or one);
#                                 --check: does <name> run on this host (ROLES / ROSTER_EXCLUDE / registry)
#                                 --host-health: is an unreadable registry keeping monsters off this host
#                                 --skip-verify: start a merge/maintain session without `fleet verify`
#                                 (typed at a terminal only; warns and alerts)
#   supervise                     one supervisor tick (what the launchd job runs)
#   verify [--alert] [--max-age <min>]
#                                 do the plugin files guarding merge/maintain match the pinned engsys
#                                 release on GitHub? exit 0 match, 1 mismatch, 3 not verified
#   install-jobs [--dry-run] [--only <job>] [--unload]
#                                 render + (re)load the launchd jobs
#   notify --level info|action|alert [--re <url>] [--incident <key>] [--resolve] "<text>"
#                                 post to the fleet's own Slack voice (falls back to a GitHub comment)
#   heartbeat "<summary>"         write this fleet's heartbeat onto its own status issue (federation.yml
#                                 fleets.<FLEET_ID>.status_issue); no-op in single-fleet mode. What the
#                                 supervisor's HEARTBEAT_CMD calls once per tick.
#   federation validate|get|home|address|status ...
#                                 the multi-fleet registry (federation.yml; see `fleet federation --help`)
#   init ...                      scaffold a new fleet instance (engsys fleet init)
#
# The instance is --instance <dir>, else $FLEET_INSTANCE, else the git toplevel of the current
# directory. An instance's scripts/fleet shim normally does this for you:
#   exec "$ENGSYS_DIR/core/fleet/bin/fleet" --instance <root> "$@"
set -euo pipefail

KIT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

instance="${FLEET_INSTANCE:-}"
while [ $# -gt 0 ]; do
  case "$1" in
    --instance) instance="${2:?fleet: --instance needs a directory}"; shift 2 ;;
    --instance=*) instance="${1#--instance=}"; shift ;;
    *) break ;;
  esac
done
cmd="${1:-status}"; [ $# -gt 0 ] && shift

case "$cmd" in
  -h | --help | help) sed -n '2,/^set -/{/^set -/!p;}' "$0"; exit 0 ;;
  init) # the engsys CLI (this kit lives at <engsys>/core/fleet); no instance needed yet
    exec "$KIT/../../install" fleet init "$@" ;;
  status | pin | sync | restart | launch | supervise | verify | install-jobs | notify | heartbeat | federation) ;;
  *) echo "fleet: unknown command '$cmd' (fleet help)" >&2; exit 2 ;;
esac

[ -n "$instance" ] || instance="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$instance" ] || { echo "fleet: no instance — pass --instance <dir>, set FLEET_INSTANCE, or run inside the instance repo" >&2; exit 1; }
FLEET_INSTANCE="$(cd "$instance" 2>/dev/null && pwd -P)" || { echo "fleet: instance directory not found: $instance" >&2; exit 1; }
export FLEET_INSTANCE

# `status --federation` is its own read-only view; everything else about `status` is unchanged.
if [ "$cmd" = status ]; then
  for a in "$@"; do [ "$a" = --federation ] && exec bash "$KIT/federation-status.sh" "$@"; done
fi

case "$cmd" in
  status) bash "$KIT/federation.sh" status || true; echo; bash "$KIT/sync.sh" --check || true; echo; exec bash "$KIT/restart.sh" --status ;;
  pin)
    [ -f "$KIT/pin.sh" ] || { echo "fleet pin: not implemented yet" >&2; exit 1; }
    exec bash "$KIT/pin.sh" "$@" ;;
  sync) exec bash "$KIT/sync.sh" "$@" ;;
  restart) exec bash "$KIT/restart.sh" "$@" ;;
  launch) exec bash "$KIT/launch.sh" "$@" ;;
  supervise) exec bash "$KIT/supervise.sh" "$@" ;;
  verify) exec bash "$KIT/verify.sh" "$@" ;;
  install-jobs) exec bash "$KIT/install-jobs.sh" "$@" ;;
  notify) exec bash "$KIT/notify.sh" "$@" ;;
  heartbeat) exec bash "$KIT/heartbeat.sh" "$@" ;;
  federation) exec bash "$KIT/federation.sh" "$@" ;;
esac
