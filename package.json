{
  "name": "engsys",
  "version": "2.0.1",
  "description": "The meta-harness for AI software engineering — 15 specialist personas, 24 stack packs, Adaptive SDD, compounding memory, and an optional autonomous fleet for Claude Code, GitHub Copilot CLI, and Google Antigravity.",
  "bin": {
    "engsys": "./install"
  },
  "files": [
    "install",
    "DEPLOY.md",
    "lib/",
    "core/",
    "optional-agents/",
    "stacks/",
    "engsys.config.example.yaml"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "prepublishOnly": "node lib/selftest.js && node scripts/build-plugins.mjs --check",
    "build:plugins": "node scripts/build-plugins.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "claude",
    "claude-code",
    "copilot",
    "antigravity",
    "meta-harness",
    "ai",
    "agents",
    "engineering",
    "scaffolding",
    "installer",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eric-sabe/engsys.git"
  },
  "homepage": "https://eric-sabe.github.io/engsys/",
  "bugs": {
    "url": "https://github.com/eric-sabe/engsys/issues"
  },
  "license": "MIT"
}
